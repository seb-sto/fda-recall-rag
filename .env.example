# Anthropic API key — used for both answer generation and the RAGAS-style evaluation judge (Sonnet)
CLAUDE_API_KEY=sk-ant-your-key-here

# openFDA API key — raises the rate limit from 1,000 to 120,000 requests/day
# Get one at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=your-openfda-key-here

# API key clients must send to this app's own endpoints (choose any string)
API_KEY=choose-your-own-secret-key

# Claude model used for answer generation (optional — defaults to Haiku if unset)
LLM_MODEL=claude-haiku-4-5-20251001

# ChromaDB connection (optional — these defaults are correct for local dev;
# docker-compose.yml overrides them to chromadb/8000 for the containerized API service)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Base URL the Streamlit UI uses to reach the FastAPI service (optional — defaults to
# localhost:8000 for local dev; docker-compose.yml overrides this to http://api:8000)
API_URL=http://localhost:8000
